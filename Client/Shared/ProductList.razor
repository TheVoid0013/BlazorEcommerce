@inject IProductService ProductService
@implements IDisposable

@if (ProductService.Products == null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (ProductService.Products.Count == 0)
{
    <div class="alert alert-info" role="alert">@ProductService.Message</div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var product in ProductService.Products)
        {
            <div class="card">
                <div class="card-body d-flex flex-wrap media">
                    <div class="media-img-wrapper me-3">
                        <a href="/product/@product.Id">
                            <img class="media-img" src="@product.ImageUrl" alt="@product.Title">
                        </a>
                    </div>
                    <div class="media-body">
                        <a href="/product/@product.Id" class="text-decoration-none">
                            <h4 class="mb-1">@product.Title</h4>
                        </a>
                        <p class="text-muted">@product.Description</p>
                        <h5 class="price text-primary mb-0">
                            @GetPriceText(product)
                        </h5>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (ProductService.PageCount > 1)
    {
        <nav class="mt-4" aria-label="Product pages">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ProductService.PageCount; i++)
                {
                    var pageNumber = i;
                    <li class="page-item @(pageNumber == ProductService.CurrentPage ? "active" : "")">
                        <a class="page-link" href="/search/@ProductService.LastSearchText/@pageNumber">@pageNumber</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

@code {
    protected override void OnInitialized()
    {
        ProductService.ProductsCahanged += StateHasChanged;
    }

    public void Dispose()
    {
        ProductService.ProductsCahanged -= StateHasChanged;
    }

    private string GetPriceText(Product product)
    {
        var variants = product.Variants;
        if (variants.Count == 0)
        {
            return string.Empty;
        }
        else if (variants.Count == 1)
        {
            return $"${variants[0].Price:F2}";
        }
        decimal minPrice = variants.Min(v => v.Price);
        return $"Starting at ${minPrice:F2}";
    }
}