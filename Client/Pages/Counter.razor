@page "/counter"

<PageTitle>Counter</PageTitle>

<div class="card shadow-sm" style="max-width: 320px;">
    <div class="card-body text-center">
        <h1 class="card-title">Counter</h1>
        <p class="display-4 my-3" role="status">@currentCount</p>
        <div class="d-flex justify-content-center gap-2">
            <button class="btn btn-outline-secondary" @onclick="DecrementCount">-</button>
            <button class="btn btn-primary" @onclick="IncrementCount">+</button>
        </div>
    </div>
</div>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

    private void DecrementCount()
    {
        if (currentCount > 0)
            currentCount--;
    }
}
